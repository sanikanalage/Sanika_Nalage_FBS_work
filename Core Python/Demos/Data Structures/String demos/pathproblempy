path=input('Enter Path(NSEW):')
x=0
y=0
for i in path:
    if i=='N':
        y+=1
    elif i=='S':
        y-=1
    elif i=='E':
        x+=1
    elif i=='W':
        x-=1
    else:
        print('Invalid path..!')
        break
print(x)
print(y)
dist=((x**2)+(y**2))**0.5
print(f'Total distance travaled by the Person={dist}')